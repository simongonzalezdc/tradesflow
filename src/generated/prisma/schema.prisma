// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum Role {
  OWNER
  TECHNICIAN
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum EquipmentType {
  HVAC
  PLUMBING
  ELECTRICAL
  APPLIANCE
  ROOFING
  OTHER
}

enum NotificationType {
  REMINDER_24H
  REMINDER_48H
  CONFIRMATION
  FOLLOW_UP
  INVOICE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ============================================================================
// Core Models
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          Role      @default(TECHNICIAN)
  isActive      Boolean   @default(true)
  businessId    String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified DateTime?

  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  notifications  Notification[]
  serviceHistory ServiceHistory[]
  consents       Consent[]
  auditLogs      AuditLog[]

  @@index([businessId])
}

model Business {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  phone        String
  email        String?
  address      String?
  city         String?
  state        String?
  zipCode      String?
  logo         String?
  primaryColor String?  @default("#3B82F6")
  timezone     String   @default("America/Toronto")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users          User[]
  customers      Customer[]
  priceBookItems PriceBookItem[]
  notifications  Notification[]

  @@index([slug])
}

model Customer {
  id         String   @id @default(cuid())
  name       String
  phone      String
  email      String?
  address    String?
  city       String?
  state      String?
  zipCode    String?
  notes      String?
  businessId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  invoices     Invoice[]
  equipment    Equipment[]

  @@index([businessId])
  @@index([phone])
}

// ============================================================================
// Appointment & Scheduling
// ============================================================================

model Appointment {
  id               String            @id @default(cuid())
  customerId       String
  userId           String?
  scheduledAt      DateTime
  duration         Int               @default(60) // minutes
  status           AppointmentStatus @default(PENDING)
  notes            String?
  confirmationCode String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id])
  invoices       Invoice[]
  serviceHistory ServiceHistory[]
  notifications  Notification[]

  @@index([customerId])
  @@index([scheduledAt])
  @@index([status])
}

// ============================================================================
// Invoicing
// ============================================================================

model Invoice {
  id            String        @id @default(cuid())
  customerId    String
  appointmentId String?
  invoiceNumber String        @default(cuid())
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @default(0)
  tax           Decimal       @default(0)
  total         Decimal       @default(0)
  notes         String?
  issuedAt      DateTime?
  dueAt         DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointment Appointment?  @relation(fields: [appointmentId], references: [id])
  items       InvoiceItem[]

  @@index([customerId])
  @@index([status])
  @@index([invoiceNumber])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  rate        Decimal
  amount      Decimal
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ============================================================================
// Equipment Passport (Differentiator)
// ============================================================================

model Equipment {
  id              String        @id @default(cuid())
  customerId      String
  type            EquipmentType
  brand           String?
  model           String?
  serialNumber    String?
  installDate     DateTime?
  warrantyExpires DateTime?
  location        String?
  notes           String?
  photos          String[]      @default([])
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceHistory ServiceHistory[]

  @@index([customerId])
  @@index([type])
}

model ServiceHistory {
  id              String   @id @default(cuid())
  equipmentId     String
  appointmentId   String?
  userId          String?
  performedAt     DateTime @default(now())
  description     String
  technicianNotes String?
  photos          String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  equipment   Equipment    @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])

  @@index([equipmentId])
  @@index([performedAt])
}

// ============================================================================
// Price Book
// ============================================================================

model PriceBookItem {
  id               String   @id @default(cuid())
  businessId       String
  category         String
  serviceType      String
  description      String
  flatRate         Decimal
  estimatedMinutes Int
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, serviceType])
  @@index([businessId])
  @@index([category])
}

// ============================================================================
// Notifications
// ============================================================================

model Notification {
  id            String             @id @default(cuid())
  businessId    String
  userId        String?
  type          NotificationType
  status        NotificationStatus @default(PENDING)
  recipient     String // phone or email
  message       String
  appointmentId String?
  scheduledFor  DateTime
  sentAt        DateTime?
  failedAt      DateTime?
  errorMessage  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([businessId])
  @@index([scheduledFor])
  @@index([status])
}

// ============================================================================
// Consent & Privacy (PIPEDA Compliance)
// ============================================================================

enum ConsentType {
  PRIVACY_POLICY
  TERMS_OF_SERVICE
  MARKETING
  NOTIFICATIONS_SMS
  NOTIFICATIONS_EMAIL
  PHOTO_CAPTURE
}

model Consent {
  id          String      @id @default(cuid())
  userId      String
  consentType ConsentType
  consentText String
  version     String
  consentedAt DateTime    @default(now())
  revokedAt   DateTime?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consentType])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
